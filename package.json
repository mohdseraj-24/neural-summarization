{
  "name": "neural-summarization",
  "private": true,
  "version": "3.0.0",
  "description": "NeuralSum AI - free text summarizer (Node.js + Express + React)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present",
    "check-api": "npm run check-api -w server --silent",
    "users": "npm run users -w server --silent --",
    "check-db": "npm run check-db -w server --silent"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
